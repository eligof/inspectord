#!/usr/bin/env bash
# inspectord setup helper — run once after installation to enable group-based
# IPC socket access for a non-root user.
# Templated: @PYTHON@, @CONFIG_EXAMPLE@ and @AIDE_CONFIG_EXAMPLE@ substituted at
# install time.
set -euo pipefail

# ---------------------------------------------------------------------------
# 1. Require root
# ---------------------------------------------------------------------------
if [[ $EUID -ne 0 ]]; then
    echo "error: this script must be run as root (e.g. via sudo)" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Determine the target non-root user
# ---------------------------------------------------------------------------
user="${SUDO_USER:-${1:-}}"
if [[ -z "$user" ]]; then
    echo "error: cannot determine target user." >&2
    echo "       Run via 'sudo $0' or pass the username as the first argument." >&2
    exit 1
fi
uid=$(id -u "$user" 2>/dev/null) || {
    echo "error: user '$user' does not exist" >&2
    exit 1
}
if [[ "$uid" -eq 0 ]]; then
    echo "error: target user must not be root (uid 0)" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. Ensure the 'inspectord' system group exists (idempotent)
# ---------------------------------------------------------------------------
if getent group inspectord > /dev/null 2>&1; then
    echo "info: group 'inspectord' already exists, skipping creation"
elif command -v systemd-sysusers > /dev/null 2>&1; then
    echo "info: creating group 'inspectord' via systemd-sysusers"
    systemd-sysusers /usr/lib/sysusers.d/inspectord.conf
else
    echo "info: creating group 'inspectord' via groupadd"
    groupadd -r inspectord
fi

# ---------------------------------------------------------------------------
# 4. Add the target user to the 'inspectord' group (idempotent)
# ---------------------------------------------------------------------------
if id -nG "$user" | tr ' ' '\n' | grep -qx inspectord; then
    echo "info: '$user' is already a member of 'inspectord', skipping"
else
    echo "info: adding '$user' to group 'inspectord'"
    usermod -aG inspectord "$user"
fi

# ---------------------------------------------------------------------------
# 5. Generate config if absent
# ---------------------------------------------------------------------------
config_path="${INSPECTORD_CONFIG:-/etc/inspectord/config.toml}"
if [[ -e "$config_path" ]]; then
    echo "info: config already exists at '$config_path', skipping generation"
else
    echo "info: generating config at '$config_path'"
    mkdir -p -m 750 "$(dirname "$config_path")"
    cp "@CONFIG_EXAMPLE@" "$config_path"
    # Patch ipc.allowed_uids to include the target user's UID
    sed -i "s/^allowed_uids = .*/allowed_uids = [$uid]/" "$config_path"
    echo "info: set ipc.allowed_uids = [$uid] for user '$user'"
fi

# ---------------------------------------------------------------------------
# 6. Generate the AIDE config if absent
# ---------------------------------------------------------------------------
# Parent spec §30.6: AIDE gets no system config drop-in because inspectord owns
# its database, under /var/lib/inspectord/aide/ — deliberately NOT the distro's
# /var/lib/aide, which the Arch `aide` package and its aidecheck.timer own.
#
# This copies a config into place and stops. It does NOT run `aide --init`:
# that writes a baseline of the machine exactly as it is right now, and a setup
# script that certifies the current disk on the user's behalf is worse than no
# baseline at all. Until the user builds one, the scanner reports
# `scan_skipped` with reason `database_missing` — visible, and never a failure.
aide_config_path="${INSPECTORD_AIDE_CONFIG:-/var/lib/inspectord/aide/aide.conf}"
if [[ -e "$aide_config_path" ]]; then
    echo "info: AIDE config already exists at '$aide_config_path', skipping generation"
else
    echo "info: generating AIDE config at '$aide_config_path'"
    mkdir -p -m 750 "$(dirname "$aide_config_path")"
    cp "@AIDE_CONFIG_EXAMPLE@" "$aide_config_path"
    chmod 640 "$aide_config_path"
    echo "info: AIDE will not run until you build its baseline yourself:"
    echo "        sudo aide --config $aide_config_path --init"
    echo "        sudo mv $(dirname "$aide_config_path")/aide.db.new \\"
    echo "                $(dirname "$aide_config_path")/aide.db"
fi

# ---------------------------------------------------------------------------
# 7. Final notice
# ---------------------------------------------------------------------------
echo ""
echo "Setup complete."
echo ""
echo "IMPORTANT: '$user' must log out and back in (or run 'newgrp inspectord')"
echo "           for the new group membership to take effect in running sessions."
